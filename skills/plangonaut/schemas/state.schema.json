{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plangonaut.com/schemas/plangonaut-state-v2.json",
  "title": "Plangonaut project state (schema v2 — historical)",
  "description": "HISTORICAL. This is the v2 schema, kept so that projects written before schema v3 can be read and migrated: `plangonaut migrate` still accepts `schema_version` 1 and 2. It is not the current schema and nothing should be validated against it. The current one is `state-v3.schema.json` in this directory.",
  "type": "object",
  "required": [
    "schema_version",
    "beave_version",
    "project",
    "interaction_mode",
    "decision_owners",
    "lifecycle_state",
    "current_gate",
    "modules",
    "human_overrides",
    "needs_reconciliation",
    "revision",
    "last_event_id",
    "exact_next_action",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "beave_version": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "root",
        "mode"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "Genesis",
            "Adoption",
            "Reconstruction",
            "Evolution",
            "Resume"
          ]
        }
      },
      "additionalProperties": false
    },
    "interaction_mode": {
      "enum": [
        "Guided",
        "Standard",
        "Expert"
      ]
    },
    "intake_strategy": {
      "enum": [
        "Adaptive",
        "Brief-led"
      ]
    },
    "decision_owners": {
      "type": "object",
      "required": [
        "product",
        "technical",
        "budget",
        "safety",
        "release"
      ],
      "properties": {
        "product": {
          "type": "string",
          "minLength": 1
        },
        "technical": {
          "type": "string",
          "minLength": 1
        },
        "budget": {
          "type": "string",
          "minLength": 1
        },
        "safety": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "lifecycle_state": {
      "enum": [
        "INTAKE",
        "DISCOVERY",
        "INTERVIEW",
        "RESEARCH",
        "BLUEPRINT",
        "FOUNDATION",
        "PLAN",
        "EXECUTE",
        "VERIFY",
        "RELEASE",
        "OPERATE"
      ]
    },
    "current_gate": {
      "type": "string",
      "pattern": "^G([0-9]|1[0-2])$"
    },
    "modules": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16
          },
          "title": {
            "type": "string"
          },
          "status": {
            "enum": [
              "NOT STARTED",
              "IN DISCUSSION",
              "CONFIRMED",
              "PARTIAL",
              "DEFERRED",
              "NOT APPLICABLE",
              "BLOCKED"
            ]
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "$comment": "ALN-015. Heterogeneous by design. A plain string is a blocker written into the state file before this ledger existed: it has no owner, no date and no recorded status, it stays exactly as it was, and it is counted as OPEN because nothing ever recorded it as resolved. Converting one into a record would mean inventing the three fields it never had. New entries are records.",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "$comment": "Legacy free text. Preserved, never rewritten, always counted as open."
          },
          {
            "type": "object",
            "required": [
              "id",
              "title",
              "reason",
              "status",
              "owner",
              "recorded_at",
              "revision",
              "updated_at"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^BLK-[A-Z0-9_-]+$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "OPEN",
                  "RESOLVED"
                ]
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "recorded_at": {
                "type": "string"
              },
              "evidence": {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              "resolved_at": {
                "type": "string"
              },
              "resolved_by": {
                "type": "string"
              },
              "resolution": {
                "type": "string"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "updated_at": {
                "type": "string"
              }
            },
            "$comment": "RESOLVED keeps the record and gains resolution, resolved_by and resolved_at. Resolving never deletes: a blocker that happened and was cleared is part of how the project went."
          }
        ]
      }
    },
    "blockers_none_verified": {
      "type": [
        "object",
        "null"
      ],
      "$comment": "ALN-015. Somebody looked and found nothing open, with their name on it. NOT required: every project written before this is valid and carries none, and absent means 'nobody has said so', which is why status answers UNKNOWN rather than NONE_VERIFIED. Cleared by any blocker mutation, because a verification is a statement about one state of the ledger and the ledger changing makes it stale rather than merely older.",
      "required": [
        "at",
        "by",
        "state_revision",
        "event_id"
      ],
      "properties": {
        "at": {
          "type": "string"
        },
        "by": {
          "type": "string",
          "minLength": 1
        },
        "state_revision": {
          "type": "integer",
          "minimum": 1
        },
        "event_id": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "risks": {
      "type": "array"
    },
    "evidence": {
      "type": "array"
    },
    "human_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "owner",
          "source",
          "source_sha256",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OVR-[a-f0-9]{12}$"
          },
          "status": {
            "enum": [
              "OPEN",
              "RECONCILED"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "created_at": {
            "type": "string"
          }
        }
      }
    },
    "needs_reconciliation": {
      "type": "boolean"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "last_event_id": {
      "type": "string",
      "minLength": 1
    },
    "exact_next_action": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  }
}
