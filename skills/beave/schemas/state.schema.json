{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beavelab.it/schemas/beave-state-v2.json",
  "title": "Beave project state",
  "type": "object",
  "required": [
    "schema_version",
    "beave_version",
    "project",
    "interaction_mode",
    "decision_owners",
    "lifecycle_state",
    "current_gate",
    "modules",
    "human_overrides",
    "needs_reconciliation",
    "revision",
    "last_event_id",
    "exact_next_action",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "beave_version": {"type": "string"},
    "project": {
      "type": "object",
      "required": ["name", "root", "mode"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "root": {"type": "string", "minLength": 1},
        "mode": {"enum": ["Genesis", "Adoption", "Reconstruction", "Evolution", "Resume"]}
      },
      "additionalProperties": false
    },
    "interaction_mode": {"enum": ["Guided", "Standard", "Expert"]},
    "intake_strategy": {"enum": ["Adaptive", "Brief-led"]},
    "decision_owners": {
      "type": "object",
      "required": ["product", "technical", "budget", "safety", "release"],
      "properties": {
        "product": {"type": "string", "minLength": 1},
        "technical": {"type": "string", "minLength": 1},
        "budget": {"type": "string", "minLength": 1},
        "safety": {"type": "string", "minLength": 1},
        "release": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "lifecycle_state": {
      "enum": ["INTAKE", "DISCOVERY", "INTERVIEW", "RESEARCH", "BLUEPRINT", "FOUNDATION", "PLAN", "EXECUTE", "VERIFY", "RELEASE", "OPERATE"]
    },
    "current_gate": {"type": "string", "pattern": "^G([0-9]|1[0-2])$"},
    "modules": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {
        "type": "object",
        "required": ["id", "title", "status"],
        "properties": {
          "id": {"type": "integer", "minimum": 0, "maximum": 16},
          "title": {"type": "string"},
          "status": {"enum": ["NOT STARTED", "IN DISCUSSION", "CONFIRMED", "PARTIAL", "DEFERRED", "NOT APPLICABLE", "BLOCKED"]}
        }
      }
    },
    "blockers": {"type": "array"},
    "risks": {"type": "array"},
    "evidence": {"type": "array"},
    "human_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "owner", "source", "source_sha256", "created_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^OVR-[a-f0-9]{12}$"},
          "status": {"enum": ["OPEN", "RECONCILED"]},
          "owner": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "created_at": {"type": "string"}
        }
      }
    },
    "needs_reconciliation": {"type": "boolean"},
    "revision": {"type": "integer", "minimum": 1},
    "last_event_id": {"type": "string", "minLength": 1},
    "exact_next_action": {"type": "string", "minLength": 1},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  }
}
