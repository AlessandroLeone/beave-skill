{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beavelab.it/schemas/beave-state-v3.json",
  "title": "Beave project state",
  "type": "object",
  "required": [
    "schema_version",
    "beave_version",
    "project",
    "interaction_mode",
    "decision_owners",
    "lifecycle_state",
    "current_gate",
    "human_overrides",
    "needs_reconciliation",
    "revision",
    "last_event_id",
    "exact_next_action",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "beave_version": {"type": "string"},
    "project": {
      "type": "object",
      "required": ["name", "root", "mode"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "root": {"type": "string", "minLength": 1},
        "mode": {"enum": ["Genesis", "Adoption", "Reconstruction", "Evolution", "Resume"]}
      },
      "additionalProperties": false
    },
    "interaction_mode": {"enum": ["Guided", "Standard", "Expert"]},
    "intake_strategy": {"enum": ["Adaptive", "Brief-led"]},
    "decision_owners": {
      "type": "object",
      "required": ["product", "technical", "budget", "safety", "release"],
      "properties": {
        "product": {"type": "string", "minLength": 1},
        "technical": {"type": "string", "minLength": 1},
        "budget": {"type": "string", "minLength": 1},
        "safety": {"type": "string", "minLength": 1},
        "release": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "lifecycle_state": {
      "enum": ["INTAKE", "DISCOVERY", "INTERVIEW", "RESEARCH", "BLUEPRINT", "FOUNDATION", "PLAN", "EXECUTE", "VERIFY", "RELEASE", "OPERATE"]
    },
    "current_gate": {"type": "string", "pattern": "^G([0-9]|1[0-2])$"},
    
    "modules": { "type": "array" },

    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "revision", "updated_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^DEC-[a-f0-9]{8,12}$"},
          "title": {"type": "string"},
          "status": {"enum": ["PROPOSED", "APPROVED", "REJECTED", "SUPERSEDED"]},
          "owner": {"type": "string"},
          "revision": {"type": "integer"},
          "updated_at": {"type": "string"}
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "revision"],
        "properties": {
          "id": {"type": "string", "pattern": "^REQ-[a-f0-9]{8,12}$"},
          "title": {"type": "string"},
          "status": {"enum": ["DRAFT", "ACTIVE", "DEFERRED", "OBSOLETE"]},
          "revision": {"type": "integer"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "status", "revision"],
        "properties": {
          "id": {"type": "string", "pattern": "^ART-[a-f0-9]{8,12}$"},
          "path": {"type": "string"},
          "status": {"enum": ["DRAFT", "PUBLISHED", "DEPRECATED"]},
          "revision": {"type": "integer"}
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "revision"],
        "properties": {
          "id": {"type": "string", "pattern": "^TSK-[a-f0-9]{8,12}$"},
          "title": {"type": "string"},
          "status": {"enum": ["BACKLOG", "READY", "IN_PROGRESS", "REVIEW", "DONE", "BLOCKED"]},
          "revision": {"type": "integer"}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "type"],
        "properties": {
          "id": {"type": "string", "pattern": "^DEP-[a-f0-9]{8,12}$"},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "type": {"enum": ["BLOCKS", "REQUIRES", "RELATES_TO"]}
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^GAT-[a-f0-9]{8,12}$"},
          "name": {"type": "string"},
          "status": {"enum": ["PENDING", "PASSED", "WARN", "BLOCKED", "NOT_APPLICABLE"]}
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^RSK-[a-f0-9]{8,12}$"},
          "title": {"type": "string"},
          "severity": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
          "status": {"enum": ["IDENTIFIED", "MITIGATED", "ACCEPTED", "REALIZED"]}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^EVD-[a-f0-9]{8,12}$"},
          "path": {"type": "string"},
          "sha256": {"type": "string"}
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^AGT-[a-f0-9]{8,12}$"},
          "name": {"type": "string"},
          "status": {"enum": ["PROPOSED", "ACTIVE", "RETIRED"]}
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^OP-[a-f0-9]{8,12}$"},
          "type": {"type": "string"},
          "status": {"enum": ["PENDING", "SUCCESS", "FAILED"]}
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "created_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^CHK-[a-f0-9]{8,12}$"},
          "name": {"type": "string"},
          "created_at": {"type": "string"}
        }
      }
    },

    "blockers": {"type": "array"},
    "human_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "owner", "source", "source_sha256", "created_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^OVR-[a-f0-9]{12}$"},
          "status": {"enum": ["OPEN", "RECONCILED"]},
          "owner": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "created_at": {"type": "string"}
        }
      }
    },
    "needs_reconciliation": {"type": "boolean"},
    "revision": {"type": "integer", "minimum": 1},
    "last_event_id": {"type": "string", "minLength": 1},
    "exact_next_action": {"type": "string", "minLength": 1},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  }
}
